{
    "name": "remigarcia/fulll-hiring-algo",
    "description": "Fulll hiring test — FizzBuzz",
    "license": "proprietary",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Fulll\\Algo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fulll\\Algo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs:check": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "qa": [
            "@cs:check",
            "@stan",
            "@test"
        ]
    }
}
